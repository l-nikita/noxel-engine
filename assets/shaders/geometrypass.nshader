{
    "name": "GeometryPass",
    "source_language": "HLSL",
    "pixel_shader": {
        "file": "geometrypass_ps.hlsl"
    },
    "vertex_shader": {
        "file": "geometrypass_vs.hlsl"
    },
    "parameters": {
        "textures": {
            "color": {
                "var_bind": "g_tColor",
                "var_type": "MUTABLE",
                "def_texture": "white"
            },
            "normal": {
                "var_bind": "g_tNormal",
                "var_type": "MUTABLE",
                "def_texture": "neutral_normal"
            },
            "rough": {
                "var_bind": "g_tRoughness",
                "var_type": "MUTABLE",
                "def_texture": "white"
            },
            "metal": {
                "var_bind": "g_tMetalness",
                "var_type": "MUTABLE",
                "def_texture": "black"
            },
            "ao": {
                "var_bind": "g_tAO",
                "var_type": "MUTABLE",
                "def_texture": "white"
            },
            "height": {
                "var_bind": "g_tHeight",
                "var_type": "MUTABLE",
                "def_texture": "black"
            }
        },
        "samplers": {
            "g_sSampler": {
                "min_filter": "LINEAR",
                "mag_filter": "LINEAR",
                "mip_filter": "LINEAR",
                "address_u": "WRAP",
                "address_v": "WRAP",
                "address_w": "WRAP"
            }
        }
    }
}
